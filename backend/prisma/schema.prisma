enum ModuleConfigCategoryEnum {
  core
  clinical
  financial
  operations
}

enum AttendanceStatusEnum {
  present
  absent
  late
  half_day
  on_leave
}

model hospitals {
  id                      Int                              @id @default(autoincrement())
  name                    String
  code                    String
  logo_path               String?
  address                 String?
  city                    String?
  county                  String?
  country                 String?                          @default("Kenya")
  phone                   String?
  alternative_phone       String?
  email                   String?
  website                 String?
  license_number          String?
  tax_pin                 String?
  consultation_fee        Decimal?                         @default(500) @db.Decimal(10, 2)
  subscription_status     HospitalsSubscriptionStatusEnum? @default(trial)
  subscription_plan       HospitalsSubscriptionPlanEnum?   @default(basic)
  subscription_start_date DateTime?
  subscription_end_date   DateTime?
  subscription_expires_at DateTime?
  billing_contact_email   String?
  timezone                String?                          @default("Africa/Nairobi")
  currency                String?                          @default("KES")
  date_format             String?                          @default("DD/MM/YYYY")
  is_active               Boolean?                         @default(true)
  created_by              Int?
  created_at              DateTime?                        @default(now())
  updated_at              DateTime?                        @updatedAt
  deleted_at              DateTime?

  @@unique([code], map: "uk_hospital_code")
  @@index([code], map: "idx_code")
  @@index([subscription_status], map: "idx_subscription_status")
  @@index([is_active], map: "idx_is_active")
}

model branches {
  id             Int       @id @default(autoincrement())
  hospital_id    Int
  name           String
  code           String
  address        String?
  city           String?
  phone          String?
  email          String?
  is_main_branch Boolean?  @default(false)
  is_active      Boolean?  @default(true)
  supervisor_id  Int?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  @@unique([hospital_id, code], map: "unique_branch_code")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([code], map: "idx_code")
}

model hospital_modules {
  id          Int       @id @default(autoincrement())
  hospital_id Int
  module_code String
  module_name String
  is_enabled  Boolean?  @default(false)
  enabled_at  DateTime?
  enabled_by  Int?
  config_data Json?
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt

  @@unique([hospital_id, module_code], map: "unique_hospital_module")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([module_code], map: "idx_module_code")
}

model users {
  id            Int           @id @default(autoincrement())
  hospital_id   Int?
  branch_id     Int?
  username      String
  password      String
  role          UsersRoleEnum
  phone         String?
  refresh_token String?
  lastLogin     DateTime?
  createdAt     DateTime?     @default(now())
  updated_at    DateTime?     @updatedAt
  deleted_at    DateTime?

  @@unique([username], map: "uk_username")
  @@index([username], map: "idx_username")
  @@index([role], map: "idx_role")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([branch_id], map: "idx_branch_id")
}

model patients {
  id                       Int                @id @default(autoincrement())
  patient_number           String?
  hospital_id              Int?
  name                     String
  phone                    String
  alternative_phone        String?
  email                    String?
  age                      Int
  gender                   PatientsGenderEnum
  id_number                String
  next_of_kin_name         String?
  next_of_kin_phone        String?
  next_of_kin_relationship String?
  county                   String?
  town                     String?
  address                  String?
  house_number             String?
  created_at               DateTime?          @default(now())
  updated_at               DateTime?          @updatedAt
  deleted_at               DateTime?

  @@unique([hospital_id, id_number], map: "unique_patient_per_hospital")
  @@index([phone], map: "idx_phone")
  @@index([id_number], map: "idx_id_number")
  @@index([email], map: "idx_email")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([patient_number], map: "idx_patient_number")
  @@index([hospital_id, created_at], map: "idx_patients_hospital_created")
}

model lab_test_templates {
  id            Int       @id @default(autoincrement())
  test_name     String
  test_code     String
  category      String?
  default_price Decimal?  @default(0) @db.Decimal(10, 2)
  normal_range  String?
  unit          String?
  description   String?
  is_active     Boolean?  @default(true)
  created_by    Int?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  @@unique([test_code], map: "uk_lab_test_template_code")
  @@index([category], map: "idx_lab_test_templates_category")
  @@index([is_active], map: "idx_lab_test_templates_active")
}

model lab_test_template_parameters {
  id             Int       @id @default(autoincrement())
  template_id    Int
  parameter_name String
  unit           String?
  normal_range   String?
  sort_order     Int?      @default(0)
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  @@unique([template_id, parameter_name], map: "uk_lab_test_template_parameter")
  @@index([template_id], map: "idx_lab_test_template_parameters_template")
}

model system_settings {
  id            Int       @id @default(autoincrement())
  hospital_id   Int?
  setting_key   String
  setting_value String
  description   String?
  updated_by    Int?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  @@unique([hospital_id, setting_key], map: "unique_setting_per_hospital")
  @@index([hospital_id, setting_key], map: "idx_hospital_setting")
}

model queue {
  id           Int                 @id @default(autoincrement())
  hospital_id  Int?
  branch_id    Int?
  patient_id   Int
  department   QueueDepartmentEnum
  assigned_to  Int?
  status       QueueStatusEnum?    @default(waiting)
  queue_number String
  notes        String?
  diagnosis    String?
  prescription String?
  created_at   DateTime?           @default(now())
  updated_at   DateTime?           @updatedAt

  @@index([department, status], map: "idx_department_status")
  @@index([created_at], map: "idx_created_at")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([hospital_id, department, status], map: "idx_hospital_dept_status")
  @@index([hospital_id, department, status, created_at], map: "idx_queue_hospital_dept_status_created")
}

model vitals {
  id                       Int       @id @default(autoincrement())
  hospital_id              Int?
  queue_id                 Int
  patient_id               Int
  recorded_by              Int
  blood_pressure_systolic  Decimal?  @db.Decimal(5, 2)
  blood_pressure_diastolic Decimal?  @db.Decimal(5, 2)
  temperature              Decimal?  @db.Decimal(4, 2)
  pulse_rate               Int?
  respiratory_rate         Int?
  weight                   Decimal?  @db.Decimal(5, 2)
  height                   Decimal?  @db.Decimal(5, 2)
  blood_sugar              Decimal?  @db.Decimal(5, 2)
  oxygen_saturation        Int?
  bmi                      Decimal?  @db.Decimal(5, 2)
  notes                    String?
  drug_allergies           String?
  updated_by               Int?
  created_at               DateTime? @default(now())
  updated_at               DateTime? @updatedAt

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([queue_id], map: "idx_queue_id")
  @@index([patient_id], map: "idx_patient_id")
}

model medicines {
  id          Int       @id @default(autoincrement())
  hospital_id Int?
  name        String
  barcode     String
  stock       Int       @default(0)
  price       Decimal   @db.Decimal(10, 2)
  expiry_date DateTime
  created_at  DateTime? @default(now())
  updated_at  DateTime? @updatedAt
  deleted_at  DateTime?

  @@unique([hospital_id, barcode], map: "unique_barcode_per_hospital")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([barcode], map: "idx_barcode")
  @@index([expiry_date], map: "idx_expiry")
  @@index([name], map: "idx_name")
}

model equipment {
  id              Int                  @id @default(autoincrement())
  hospital_id     Int?
  name            String
  serial_number   String
  purchase_date   DateTime
  purchase_price  Decimal?             @default(0) @db.Decimal(10, 2)
  quantity        Int?                 @default(1)
  warranty_expiry DateTime?
  status          EquipmentStatusEnum? @default(active)
  location        String?
  description     String?
  created_at      DateTime?            @default(now())
  updated_at      DateTime?            @updatedAt
  deleted_at      DateTime?

  @@unique([hospital_id, serial_number], map: "unique_serial_per_hospital")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([serial_number], map: "idx_serial_number")
  @@index([status], map: "idx_status")
}

model prescriptions {
  id          Int                      @id @default(autoincrement())
  hospital_id Int?
  queue_id    Int
  patient_id  Int
  doctor_id   Int?
  notes       String?
  diagnosis   String?
  status      PrescriptionsStatusEnum? @default(pending)
  created_at  DateTime?                @default(now())
  updated_at  DateTime?                @updatedAt
  deleted_at  DateTime?

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([hospital_id, status], map: "idx_hospital_status")
  @@index([status], map: "idx_status")
  @@index([patient_id], map: "idx_patient_id")
  @@index([hospital_id, status, created_at], map: "idx_prescriptions_hospital_status_created")
}

model prescription_items {
  id                   Int      @id @default(autoincrement())
  prescription_id      Int
  medicine_id          Int?
  custom_medicine_name String?
  custom_price         Decimal? @db.Decimal(10, 2)
  quantity             Int
  dosage               String?
  duration             String?
  instructions         String?

  @@index([prescription_id], map: "idx_prescription_id")
}

model sales {
  id              Int                     @id @default(autoincrement())
  hospital_id     Int?
  prescription_id Int
  pharmacist_id   Int?
  total_amount    Decimal                  @db.Decimal(10, 2)
  payment_method  SalesPaymentMethodEnum? @default(cash)
  created_at      DateTime?               @default(now())

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([created_at], map: "idx_created_at")
}

model sales_items {
  id          Int     @id @default(autoincrement())
  sale_id     Int
  medicine_id Int
  quantity    Int
  unit_price  Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  @@index([sale_id], map: "idx_sale_id")
}

model direct_sales {
  id             Int       @id @default(autoincrement())
  hospital_id    Int?
  branch_id      Int?
  total_amount   Decimal   @db.Decimal(10, 2)
  payment_method String?   @default("cash")
  sold_by        Int?
  sale_date      DateTime? @default(now())

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([sale_date], map: "idx_sale_date")
}

model direct_sale_items {
  id            Int      @id @default(autoincrement())
  sale_id       Int
  medicine_id   Int?
  medicine_name String?
  quantity      Int
  price         Decimal  @db.Decimal(10, 2)
  unit_price    Decimal? @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  is_custom     Boolean? @default(false)

  @@index([sale_id], map: "idx_sale_id")
}

model lab_tests {
  id           Int       @id @default(autoincrement())
  hospital_id  Int?
  template_id  Int?
  test_name    String
  test_code    String
  category     String?
  price        Decimal   @db.Decimal(10, 2)
  normal_range String?
  unit         String?
  description  String?
  is_enabled   Boolean?  @default(false)
  is_custom    Boolean?  @default(false)
  synced_at    DateTime?
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt

  @@unique([hospital_id, template_id], map: "unique_hospital_template_test")
  @@unique([hospital_id, test_code], map: "unique_test_code_per_hospital")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([template_id], map: "idx_lab_tests_template_id")
  @@index([test_code], map: "idx_test_code")
  @@index([category], map: "idx_category")
  @@index([hospital_id, is_enabled], map: "idx_lab_tests_hospital_enabled")
}

model lab_orders {
  id          Int                  @id @default(autoincrement())
  hospital_id Int?
  queue_id    Int
  patient_id  Int
  doctor_id   Int?
  status      LabOrdersStatusEnum? @default(pending)
  notes       String?
  created_at  DateTime?            @default(now())
  updated_at  DateTime?            @updatedAt
  deleted_at  DateTime?

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([hospital_id, status], map: "idx_hospital_status")
  @@index([status], map: "idx_status")
  @@index([patient_id], map: "idx_patient_id")
}

model lab_order_items {
  id           Int                      @id @default(autoincrement())
  lab_order_id Int
  lab_test_id  Int
  status       LabOrderItemsStatusEnum? @default(pending)

  @@index([lab_order_id], map: "idx_lab_order_id")
}

model lab_test_parameters {
  id                    Int       @id @default(autoincrement())
  lab_test_id           Int
  template_parameter_id Int?
  parameter_name        String
  unit                  String?
  normal_range          String?
  created_at            DateTime? @default(now())
  updated_at            DateTime? @updatedAt

  @@index([lab_test_id], map: "idx_lab_test_id")
  @@index([template_parameter_id], map: "idx_lab_test_parameters_template_parameter")
}

model lab_results {
  id                    Int       @id @default(autoincrement())
  lab_order_item_id     Int
  lab_test_parameter_id Int
  result_value          String?
  remarks               String?
  is_abnormal           Boolean?  @default(false)
  tested_by             Int?
  tested_at             DateTime? @default(now())
}

model radiology_exams {
  id                       Int                           @id @default(autoincrement())
  hospital_id              Int?
  imaging_type             RadiologyExamsImagingTypeEnum @default(xray)
  exam_code                String
  exam_name                String
  body_part                String                        @default("General")
  category                 String?
  modality                 RadiologyExamsModalityEnum
  price                    Decimal                       @db.Decimal(10, 2)
  duration_minutes         Int?                          @default(30)
  description              String?
  preparation_instructions String?
  is_active                Boolean?                      @default(true)
  created_at               DateTime?                     @default(now())
  updated_at               DateTime?                     @updatedAt

  @@unique([hospital_id, exam_code], map: "unique_exam_per_hospital")
  @@index([hospital_id], map: "idx_hospital_id")
  @@index([modality], map: "idx_modality")
}

model radiology_orders {
  id                  Int                          @id @default(autoincrement())
  hospital_id         Int?
  queue_id            Int
  patient_id          Int
  doctor_id           Int?
  exam_id             Int
  clinical_indication String?
  priority            RadiologyOrdersPriorityEnum? @default(routine)
  status              RadiologyOrdersStatusEnum?   @default(pending)
  scheduled_at        DateTime?
  performed_by        Int?
  performed_at        DateTime?
  findings            String?
  impression          String?
  recommendations     String?
  reported_by         Int?
  reported_at         DateTime?
  created_at          DateTime?                    @default(now())
  updated_at          DateTime?                    @updatedAt
  deleted_at          DateTime?

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([hospital_id, status], map: "idx_hospital_status")
  @@index([status], map: "idx_status")
  @@index([patient_id], map: "idx_patient_id")
}

model radiology_templates {
  id               Int                               @id @default(autoincrement())
  template_name    String
  imaging_type     RadiologyTemplatesImagingTypeEnum
  body_part        String?
  template_content String
  is_default       Boolean?                          @default(false)
  created_by       Int?
  created_at       DateTime?                         @default(now())
  updated_at       DateTime?                         @updatedAt
}

model bills {
  id               Int                     @id @default(autoincrement())
  hospital_id      Int?
  branch_id        Int?
  patient_id       Int
  queue_id         Int?
  total_amount     Decimal                 @default(0) @db.Decimal(10, 2)
  consultation_fee Decimal?                @default(0) @db.Decimal(10, 2)
  lab_fee          Decimal?                @default(0) @db.Decimal(10, 2)
  pharmacy_fee     Decimal?                @default(0) @db.Decimal(10, 2)
  discount         Decimal?                @default(0) @db.Decimal(10, 2)
  final_amount     Decimal                 @db.Decimal(10, 2)
  payment_status   BillsPaymentStatusEnum? @default(pending)
  payment_method   BillsPaymentMethodEnum? @default(cash)
  created_by       Int?
  created_at       DateTime?               @default(now())
  updated_at       DateTime?               @updatedAt
  deleted_at       DateTime?

  @@index([hospital_id], map: "idx_hospital_id")
  @@index([hospital_id, payment_status], map: "idx_hospital_status")
  @@index([patient_id], map: "idx_patient_id")
  @@index([payment_status], map: "idx_payment_status")
  @@index([created_at], map: "idx_created_at")
  @@index([hospital_id, created_at, payment_status], map: "idx_bills_hospital_created_status")
}

model bill_items {
  id                   Int                   @id @default(autoincrement())
  bill_id              Int
  queue_id             Int?
  medicine_id          Int?
  custom_medicine_name String?
  item_type            BillItemsItemTypeEnum
  item_id              Int
  description          String
  quantity             Int?                  @default(1)
  unit_price           Decimal                @db.Decimal(10, 2)
  amount               Decimal?              @default(0) @db.Decimal(10, 2)
  subtotal             Decimal                @db.Decimal(10, 2)

  @@index([bill_id], map: "idx_bill_id")
}

model payments {
  id               Int                       @id @default(autoincrement())
  bill_id          Int
  amount           Decimal                   @db.Decimal(10, 2)
  payment_method   PaymentsPaymentMethodEnum
  reference_number String?
  transaction_code String?
  status           PaymentsStatusEnum?       @default(completed)
  received_by      Int?
  created_at       DateTime?                 @default(now())

  @@index([bill_id], map: "idx_bill_id")
  @@index([created_at], map: "idx_created_at")
}

model mpesa_transactions {
  id                  Int                          @id @default(autoincrement())
  hospital_id         Int?
  checkout_request_id String
  merchant_request_id String?
  phone               String
  amount              Decimal                        @db.Decimal(10, 2)
  bill_id             Int
  status              MpesaTransactionsStatusEnum? @default(pending)
  mpesa_receipt       String?
  transaction_date    String?
  result_code         Int?
  result_desc         String?
  created_at          DateTime?                    @default(now())
  updated_at          DateTime?                    @updatedAt

  @@unique([checkout_request_id], map: "uk_checkout_request")
